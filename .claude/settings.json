{
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-write-guard.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(*.py)"
    ],
    "deny": [
      "Bash(rm:*)"
    ]
  }
}