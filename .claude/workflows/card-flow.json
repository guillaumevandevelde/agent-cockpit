{
  "name": "card-flow",
  "description": "Automatische kaartbeweging gebaseerd op agent-output met impediment-handling",
  "fixed_columns": ["Backlog", "Impediment", "Done"],
  "flows": {
    "analyst": {
      "success": "developer",
      "fail": "analyst",
      "impediment": "Impediment"
    },
    "developer": {
      "success": "testing",
      "fail": "developer",
      "needs_review": "code-review",
      "needs_analysis": "analyst",
      "impediment": "Impediment"
    },
    "testing": {
      "success": "Done",
      "fail": "developer",
      "needs_fix": "developer",
      "needs_clarification": "analyst",
      "impediment": "Impediment"
    },
    "code-review": {
      "success": "Done",
      "fail": "developer",
      "needs_changes": "developer",
      "impediment": "Impediment"
    }
  },
  "impediment_agents": {
    "developer": ["analyst", "testing", "code-review"],
    "tester": ["developer", "analyst"],
    "analyst": ["developer"],
    "code-review": ["developer"]
  },
  "manual_override": {
    "allowed": true,
    "columns": ["Backlog", "Impediment", "Done"]
  }
}
