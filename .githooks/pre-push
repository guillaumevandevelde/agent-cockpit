#!/usr/bin/env bash
# Pre-push gate. Two jobs, in order:
#   1. Run the test set so green-before-push is systematic, not ad-hoc. A red gate
#      blocks the push *before* any local state is touched.
#   2. Auto-rebase on the remote (the original behaviour) to prevent divergence.
#
# Active via `git config core.hooksPath .githooks` (set by scripts/install-hooks.sh,
# called from scripts/install.sh). Tracked in the repo, so every clone and every git
# worktree -- dispatched agents included -- gets the same gate.
#
# The gate runs backend pytest + frontend ESLint + tsc/vite build against the code of
# the checkout being pushed, reusing this checkout's venv/node_modules and falling back
# to the main checkout's (worktrees don't have their own). If a tool environment is
# genuinely absent it SKIPS that half with a loud warning rather than blocking a push it
# cannot meaningfully test. Emergency bypass: git push --no-verify
set -uo pipefail

REMOTE="${1:-origin}"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
# Parent of the common git dir = the main checkout (same path for a normal clone).
MAIN="$(cd "$(dirname "$(git rev-parse --git-common-dir)")" && pwd)"
# When pushing from a bare top-level checkout, --show-toplevel is empty; fall back
# to the main checkout so `cd "$ROOT/backend"` doesn't become `cd /backend`.
[ -z "$ROOT" ] && ROOT="$MAIN"

bold=$'\033[1m'; red=$'\033[31m'; grn=$'\033[32m'; ylw=$'\033[33m'; rst=$'\033[0m'
say()  { printf '%s\n' "${bold}[pre-push]${rst} $*"; }
fail() { printf '%s\n' "${red}[pre-push] $*${rst}" >&2; }
warn() { printf '%s\n' "${ylw}[pre-push] $*${rst}" >&2; }

# ---- 0. tree-wipe guard --------------------------------------------------------
# A test git-fixture once committed `init`/`a.txt` onto HEAD (715 files -> 1) and it
# got pushed to master, wiping the default branch. Refuse to push any ref whose new
# tip both drops below a file floor AND removes most of the branch. Recovery pushes
# GROW the tree so they pass. Intentional wipe: ALLOW_TREE_WIPE=1 git push …
# pre-push feeds ref updates on stdin: "<local ref> <local sha> <remote ref> <remote sha>".
while read -r _lref lsha _rref rsha; do
    [ -z "${lsha:-}" ] && continue
    [[ "$lsha" =~ ^0+$ ]] && continue          # branch deletion — nothing pushed
    [[ "$rsha" =~ ^0+$ ]] && continue          # brand-new remote branch — nothing to destroy
    if [ -n "${ALLOW_TREE_WIPE:-}" ]; then
        warn "tree-wipe guard bypassed (ALLOW_TREE_WIPE set) for ${_rref:-ref}"
        continue
    fi
    newn=$(git ls-tree -r --name-only "$lsha" 2>/dev/null | wc -l | tr -d ' ')
    oldn=$(git ls-tree -r --name-only "$rsha" 2>/dev/null | wc -l | tr -d ' ')
    [ "${oldn:-0}" -gt 0 ] 2>/dev/null || continue   # old tip unavailable — can't compare
    if [ "${newn:-0}" -lt 20 ] && [ "$newn" -lt "$(( oldn * 2 / 5 ))" ]; then
        fail "REFUSING push: ${_rref:-ref} would go from $oldn files to $newn — looks like a tree wipe."
        fail "If this is deliberate, re-run with:  ALLOW_TREE_WIPE=1 git push …"
        exit 1
    fi
done

status=0

# ---- 1a. backend: pytest ----------------------------------------------------
VENV_PY=""
for cand in "$ROOT/backend/venv/bin/python" "$MAIN/backend/venv/bin/python"; do
    [ -x "$cand" ] && { VENV_PY="$cand"; break; }
done
if [ -n "$VENV_PY" ]; then
    say "backend: pytest"
    # cd into this checkout's backend so the worktree's own app/ is imported,
    # while reusing the (possibly main) venv's installed dependencies.
    if ( cd "$ROOT/backend" && "$VENV_PY" -m pytest tests -q ); then
        say "${grn}backend tests passed${rst}"
    else
        fail "backend tests FAILED"
        status=1
    fi
else
    warn "no backend venv found (run scripts/install.sh) — skipping backend tests"
fi

# ---- 1b. frontend: lint + build ---------------------------------------------
if [ -d "$ROOT/frontend/node_modules" ]; then
    say "frontend: eslint + build"
    if ( cd "$ROOT/frontend" && npm run lint && npm run build ); then
        say "${grn}frontend lint + build passed${rst}"
    else
        fail "frontend lint/build FAILED"
        status=1
    fi
else
    warn "no frontend node_modules found (run scripts/install.sh) — skipping frontend checks"
fi

if [ "$status" -ne 0 ]; then
    fail "push blocked. Fix the above, or bypass with: git push --no-verify"
    exit "$status"
fi

# ---- 2. auto-rebase on remote to prevent branch divergence ------------------
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$CURRENT_BRANCH" ]; then
    exit 0
fi

DIVERGED=$(git log --oneline HEAD.."$REMOTE"/"$CURRENT_BRANCH" 2>/dev/null | wc -l)
if [ "$DIVERGED" -gt 0 ]; then
    echo "⚠️  Remote has $DIVERGED commit(s) you don't have locally."
    echo "   Auto-rebasing on $REMOTE/$CURRENT_BRANCH..."
    if ! git pull --rebase "$REMOTE" "$CURRENT_BRANCH"; then
        echo "❌ Rebase failed. Fix conflicts manually, then push again."
        exit 1
    fi
    echo "✅ Rebase complete."
fi

exit 0
