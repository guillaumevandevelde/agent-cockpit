# Force LF line endings for scripts and text files on all platforms
*.sh        text eol=lf
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
Dockerfile  text eol=lf
