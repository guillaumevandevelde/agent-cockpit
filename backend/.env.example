# Copy to backend/.env and adjust as needed. All settings are optional —
# see backend/app/config.py for full defaults.

# Require this token on API requests (X-API-Token header). Leave unset to
# allow unauthenticated local access.
# API_TOKEN=

# Base URL advertised to clients (Claude Code hooks, the kanban MCP entry in
# .mcp.json) when the incoming request host isn't reachable by the consumer,
# e.g. behind a reverse proxy.
# PUBLIC_BASE_URL=https://cockpit.example.com

# MiniMax credentials for the subscriptions feature. Read server-side only
# and injected into spawned tmux sessions; never stored in the database or
# returned in an API response.
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=
