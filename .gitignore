# measure-token-saver.sh default RESULT_DIR (line 102). Each gate invocation
# writes a fresh <UTC-timestamp>/ subdir under it; without this entry every
# scripts/test_*.sh run leaves an untracked dir in the worktree root and trips
# the ship pre-flight `git ls-files --others --exclude-standard` check.
.tmp-measure-token-saver/

# Git worktrees
.worktrees/


# APM dependencies
apm_modules/

# Sandcastle runtime artifacts (per-run configs + ephemeral worktrees + logs)
.sandcastle/run-config-*.json
.sandcastle/parallel-config-*.json
.sandcastle/worktrees/
.sandcastle/logs/

# Local tooling state
.mimocode/
.omo/

# superpowers subagent-driven-development scratch (briefs/reports/diffs/ledger)
.superpowers/

# iteration-loop progress files (per-card, transient until worktree is reaped)
.claude/state/

# Personal/business notes not meant for the public repo (see docs/cockpit history)
.local-notes/

# LiteLLM sidecar — echte config bevat master_key, blijft uit de repo. Het
# `.example`-sjabloon wordt wél gevolgd; gebruik `cp config/litellm/config.yaml.example
# config/litellm/config.yaml` om de sidecar te activeren. Onderdeel van de
# opt-in lifecycle uit `docs/cockpit/litellm-sidecar-lifecycle-decision.md` §2.
/config/litellm/config.yaml
